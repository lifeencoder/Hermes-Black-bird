# Model Weights & Large Checkpoints (Strictly Excluded)
hf_cache/
hf_models/
models/
weights/
checkpoints/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.tflite
*.gguf
*.ggml
*.joblib

# Hugging Face & Torch Caches
.cache/
huggingface/
torch/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
.env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
credentials.json
client_secret*.json
token.json
*.pem
*.key

# Marimo & Jupyter Notebook Caches
.marimo/
__marimo__/
.ipynb_checkpoints/

# Unit test / coverage / analysis caches
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Logs and databases
*.log
logs/
*.sqlite
*.sqlite3
*.db

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.tmp
*.temp
*~

# IDE & Editor configurations
.idea/
.vscode/
*.swp
*.swo
